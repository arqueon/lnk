#!/usr/bin/env bash

set -euo pipefail

readonly BASE_HOME="${VARIETY_HOME_ROOT:-$HOME}"
readonly NEXTCLOUD_ROOT="${NEXTCLOUD_ROOT:-$BASE_HOME/Nextcloud}"
readonly LIBRARY_ROOT="${VARIETY_LIBRARY_ROOT:-$NEXTCLOUD_ROOT/Shared/Wallpapers/Variety}"
readonly CONTRIBUTORS_ROOT="$LIBRARY_ROOT/by-contributor"
readonly ACTIVE_FAVORITES="$BASE_HOME/.config/variety/Favorites"
readonly STATE_ROOT="$BASE_HOME/.local/state/variety-favorites-sync"
readonly STATE_FILE="$STATE_ROOT/current-backup"
readonly PROCESS_CHECK_ENABLED="${VARIETY_PROCESS_CHECK_ENABLED:-true}"

host_name="$(hostnamectl --static 2>/dev/null || hostname)"
contributor_id="$(printf '%s-%s' "$host_name" "$USER" | tr '[:upper:] _/' '[:lower:]---')"
readonly CONTRIBUTOR_ID="$contributor_id"
readonly CONTRIBUTOR_DIR="$CONTRIBUTORS_ROOT/$CONTRIBUTOR_ID"

declare -A SHARED_HASH_PATH=()

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

path_kind() {
    local path="$1"
    if [[ -L "$path" ]]; then
        printf 'symlink -> %s\n' "$(readlink -f -- "$path")"
    elif [[ -d "$path" ]]; then
        printf 'directory\n'
    elif [[ -e "$path" ]]; then
        printf 'other\n'
    else
        printf 'missing\n'
    fi
}

require_nextcloud_root() {
    [[ -d "$NEXTCLOUD_ROOT" ]] || die "Nextcloud root is missing: $NEXTCLOUD_ROOT"
    compgen -G "$NEXTCLOUD_ROOT/.sync_*.db" >/dev/null ||
        die "no Nextcloud sync database was found under $NEXTCLOUD_ROOT"
}

require_variety_stopped() {
    [[ "$PROCESS_CHECK_ENABLED" == true || "$PROCESS_CHECK_ENABLED" == false ]] ||
        die "VARIETY_PROCESS_CHECK_ENABLED must be true or false"
    if [[ "$PROCESS_CHECK_ENABLED" == true ]] && pgrep -u "$UID" -x variety >/dev/null; then
        die "Variety is running; stop it with: variety --quit"
    fi
}

hash_file() {
    sha256sum -- "$1" | awk '{print $1}'
}

index_shared_library() {
    SHARED_HASH_PATH=()
    local file hash
    while IFS= read -r -d '' file; do
        hash="$(hash_file "$file")"
        SHARED_HASH_PATH["$hash"]="$file"
    done < <(find "$CONTRIBUTORS_ROOT" -type f ! -name '*.metadata.json' -print0)
}

verify_source_content() {
    local source="$1"
    local file hash
    local total=0 missing=0

    index_shared_library
    while IFS= read -r -d '' file; do
        ((total += 1))
        hash="$(hash_file "$file")"
        if [[ -z "${SHARED_HASH_PATH[$hash]+present}" ]]; then
            printf 'missing_shared_content=%s\n' "$file" >&2
            ((missing += 1))
        fi
    done < <(find "$source" -type f ! -name '*.metadata.json' -print0)

    printf 'source_content files=%s missing=%s\n' "$total" "$missing"
    ((missing == 0))
}

hashed_name() {
    local name="$1"
    local hash="$2"
    local suffix="$3"
    if [[ "$name" == *.* ]]; then
        printf '%s--%s.%s\n' "${name%.*}" "${hash:0:$suffix}" "${name##*.}"
    else
        printf '%s--%s\n' "$name" "${hash:0:$suffix}"
    fi
}

copy_without_overwrite() {
    local source="$1"
    local destination="$2"
    local tmp_file

    tmp_file="$(mktemp --tmpdir="$CONTRIBUTOR_DIR" .variety-import.XXXXXX)"
    if ! cp --reflink=auto --preserve=mode,timestamps -- "$source" "$tmp_file"; then
        unlink -- "$tmp_file"
        return 1
    fi
    mv -n -- "$tmp_file" "$destination"
    if [[ -e "$tmp_file" ]]; then
        if cmp -s -- "$source" "$destination"; then
            unlink -- "$tmp_file"
        else
            unlink -- "$tmp_file"
            die "destination appeared during import: $destination"
        fi
    fi
}

import_source_content() {
    local source="$1"
    local file hash name destination metadata
    local total=0 existing=0 copied=0

    index_shared_library
    while IFS= read -r -d '' file; do
        ((total += 1))
        hash="$(hash_file "$file")"
        if [[ -n "${SHARED_HASH_PATH[$hash]+present}" ]]; then
            ((existing += 1))
            continue
        fi

        name="${file##*/}"
        destination="$CONTRIBUTOR_DIR/$name"
        if [[ -e "$destination" ]]; then
            destination="$CONTRIBUTOR_DIR/$(hashed_name "$name" "$hash" 12)"
        fi
        if [[ -e "$destination" ]] && ! cmp -s -- "$file" "$destination"; then
            destination="$CONTRIBUTOR_DIR/$(hashed_name "$name" "$hash" 64)"
        fi
        if [[ -e "$destination" ]] && ! cmp -s -- "$file" "$destination"; then
            die "content-addressed destination collision: $destination"
        fi

        copy_without_overwrite "$file" "$destination"
        metadata="$file.metadata.json"
        if [[ -f "$metadata" ]]; then
            [[ ! -e "$destination.metadata.json" ]] ||
                cmp -s -- "$metadata" "$destination.metadata.json" ||
                die "metadata destination collision: $destination.metadata.json"
            if [[ ! -e "$destination.metadata.json" ]]; then
                copy_without_overwrite "$metadata" "$destination.metadata.json"
            fi
        fi
        SHARED_HASH_PATH["$hash"]="$destination"
        ((copied += 1))
    done < <(find "$source" -type f ! -name '*.metadata.json' -print0)

    printf 'import files=%s already_shared=%s copied=%s contributor=%s\n' \
        "$total" "$existing" "$copied" "$CONTRIBUTOR_ID"
}

status() {
    printf 'contributor=%s\n' "$CONTRIBUTOR_ID"
    printf 'nextcloud_root=%s\n' "$NEXTCLOUD_ROOT"
    printf 'library_root=%s\n' "$LIBRARY_ROOT"
    printf 'contributor_dir=%s\n' "$CONTRIBUTOR_DIR"
    printf 'active_favorites=%s (%s)\n' "$ACTIVE_FAVORITES" "$(path_kind "$ACTIVE_FAVORITES")"
    if [[ -f "$STATE_FILE" ]]; then
        printf 'backup=%s\n' "$(<"$STATE_FILE")"
    else
        printf 'backup=none\n'
    fi
}

verify() {
    require_nextcloud_root
    [[ -d "$CONTRIBUTOR_DIR" ]] || die "contributor directory is missing"
    [[ -L "$ACTIVE_FAVORITES" ]] || die "Favorites is not a symlink"
    [[ "$(readlink -f -- "$ACTIVE_FAVORITES")" == "$(readlink -f -- "$CONTRIBUTOR_DIR")" ]] ||
        die "Favorites points somewhere else"

    local files bytes backup
    if [[ -f "$STATE_FILE" ]]; then
        backup="$(<"$STATE_FILE")"
        [[ -d "$backup" ]] || die "recorded backup is missing: $backup"
        verify_source_content "$backup" || die "original Favorites content is missing from the shared library"
    fi

    files="$(find "$CONTRIBUTOR_DIR" -maxdepth 1 -type f ! -name '*.metadata.json' -printf '.' | wc -c)"
    bytes="$(du -sb -- "$CONTRIBUTOR_DIR" | awk '{print $1}')"
    printf 'verify=ok files=%s bytes=%s contributor=%s\n' "$files" "$bytes" "$CONTRIBUTOR_ID"
}

apply() {
    require_nextcloud_root
    require_variety_stopped
    mkdir -p -- "$CONTRIBUTORS_ROOT" "$STATE_ROOT"

    if [[ -L "$ACTIVE_FAVORITES" ]]; then
        verify
        return 0
    fi
    [[ -d "$ACTIVE_FAVORITES" ]] || die "Favorites is not a directory: $ACTIVE_FAVORITES"

    mkdir -p -- "$CONTRIBUTOR_DIR"
    import_source_content "$ACTIVE_FAVORITES"
    verify_source_content "$ACTIVE_FAVORITES" ||
        die "seed verification failed; Favorites was left untouched"

    local stamp backup
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="$STATE_ROOT/Favorites-before-shared-$stamp"
    [[ ! -e "$backup" ]] || die "backup target already exists: $backup"

    mv -- "$ACTIVE_FAVORITES" "$backup"
    if ! ln -s -- "$CONTRIBUTOR_DIR" "$ACTIVE_FAVORITES"; then
        mv -- "$backup" "$ACTIVE_FAVORITES"
        die "could not create symlink; original Favorites was restored"
    fi
    printf '%s\n' "$backup" >"$STATE_FILE"
    verify
}

repair() {
    require_nextcloud_root
    require_variety_stopped
    [[ -f "$STATE_FILE" ]] || die "no rollback state is recorded"
    local backup
    backup="$(<"$STATE_FILE")"
    [[ -d "$backup" ]] || die "recorded backup is missing: $backup"
    mkdir -p -- "$CONTRIBUTORS_ROOT" "$CONTRIBUTOR_DIR"

    import_source_content "$backup"
    verify_source_content "$backup" ||
        die "repair verification failed; the backup was left untouched"
    printf 'repair=ok backup=%s contributor=%s\n' "$backup" "$CONTRIBUTOR_ID"
}

rollback() {
    require_variety_stopped
    [[ -f "$STATE_FILE" ]] || die "no rollback state is recorded"
    local backup
    backup="$(<"$STATE_FILE")"
    [[ -d "$backup" ]] || die "recorded backup is missing: $backup"
    [[ -L "$ACTIVE_FAVORITES" ]] || die "Favorites is not the managed symlink"
    [[ "$(readlink -f -- "$ACTIVE_FAVORITES")" == "$(readlink -f -- "$CONTRIBUTOR_DIR")" ]] ||
        die "Favorites points somewhere else"

    rsync -a --ignore-existing -- "$CONTRIBUTOR_DIR/" "$backup/"
    unlink -- "$ACTIVE_FAVORITES"
    mv -- "$backup" "$ACTIVE_FAVORITES"
    printf '%s\n' "$CONTRIBUTOR_DIR" >"$STATE_ROOT/last-shared-directory"
    unlink -- "$STATE_FILE"
    printf 'rollback=ok restored=%s shared_copy_retained=%s\n' "$ACTIVE_FAVORITES" "$CONTRIBUTOR_DIR"
}

case "${1:-status}" in
    apply)
        apply
        ;;
    repair)
        repair
        ;;
    rollback)
        rollback
        ;;
    status)
        status
        ;;
    verify)
        verify
        ;;
    *)
        printf 'usage: %s {status|apply|verify|repair|rollback}\n' "${0##*/}" >&2
        exit 2
        ;;
esac
