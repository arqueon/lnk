// ═══ user.kdl (POR-HOST: laptop) ═══
// Solo lo específico de laptop; lo compartido vive en user-common.kdl.
// Nota: Mod+D (antes anyrun) quedó libre; overview = Mod+E.

window-rule {
    match app-id="google-chrome"
    default-column-width { proportion 1.0; }
    opacity 1.0
    open-focused true
}

window-rule {
    match app-id="firefox"
    default-column-width { proportion 0.7; }
    opacity 1.0
    open-focused true
}

/- window-rule {
    match app-id=r#"^(firefox|org\.mozilla\.firefox)(-.*)?$"#
    match app-id=r#"^google-chrome(-.*)?$"#
    match app-id=r#"^com\.google\.Chrome(-.*)?$"#
    open-on-workspace "web"
}


// ── Arranque de triple instancia de Logseq (casa, ofi, laptop) ──
spawn-sh-at-startup "exec ~/.local/bin/logseq-multi-launch"

// ── Binds propios ──
binds {
    Mod+F4 { spawn-sh "exec ~/.local/bin/logseq-multi-launch"; }
}
