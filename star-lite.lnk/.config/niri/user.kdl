// ═══ user.kdl (POR-HOST: star-lite) ═══
// Compartido por los usuarios de star-lite; lo común vive en user-common.kdl.
// Nota: Mod+D (antes anyrun) quedó libre; overview = Mod+E.

// ── Arranque de Logseq DB canónico (arq-unificado) ──
spawn-sh-at-startup "exec ~/.local/bin/logseqdb"

window-rule {
    match app-id="google-chrome"
    default-column-width { proportion 1.0; }
    opacity 1.0
    open-focused true
}

window-rule {
    match app-id="firefox"
    default-column-width { proportion 0.7; }
    opacity 1.0
    open-focused true
}

window-rule {
    match app-id="hermes-broker-unlock"
    open-floating true
    default-column-width { fixed 680; }
    default-window-height { fixed 260; }
    open-focused true
}

binds {
    Mod+F4 { spawn-sh "exec ~/.local/bin/logseqdb"; }
    Mod+Shift+F5 hotkey-overlay-title="Sincronizar Palestina (Zettlr / Git)" { spawn "~/.config/niri/scripts/sync-palestina.sh"; }
    Mod+Alt+Return { spawn-sh "nemo ~/Downloads/ || thunar ~/Downloads/"; }
    Mod+Ctrl+Shift+F10 hotkey-overlay-title="Desbloquear Broker Moodle de Hermes" { spawn "~/.config/niri/scripts/hermes-bw-moodle-unlock.sh"; }
}
