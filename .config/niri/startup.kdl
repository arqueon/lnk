// ═══ startup.kdl (COMÚN a todos los hosts) ═══
// Procesos lanzados al iniciar sesión. Ojo: esto corre en TODOS los
// equipos gestionados por lnk; lo específico de un host va en su user.kdl.
// DMS (barras/shell) NO se lanza aquí: corre como servicio systemd
// de usuario (dms.service).
// abdel-lite usa el perfil ligero aprobado para star: Logseq y Variety se
// inician; el resto de procesos pesados continúa omitido solo en ese host.

// ── Agentes de sistema y bandeja ──
// spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec blueman-applet"
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec nm-applet --indicator"
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec kdeconnectd"
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec kdeconnect-indicator"

// ── Aplicaciones de sesión ──
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || { sleep 15 && exec insync; }"
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec ~/.config/niri/scripts/launch-anytype.sh"
// sdoc library: movido a systemd (sdoc-library.service, en lnk) para tener
// Restart=on-failure. En un host nuevo: systemctl --user enable --now sdoc-library
// spawn-at-startup "~/.config/niri/scripts/sdoc-open.sh"
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec ferdium"
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec zotero"
spawn-sh-at-startup "sleep 10 && exec variety"
// spawn-sh-at-startup "logseq"
// Tine (AppImage de Shelly en ~/.local/bin; glob para sobrevivir a updates).
// Regla de workspace "notes" en dms/windowrules.kdl.
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec ~/.local/bin/Tine_*.AppImage"
// Mindwtr (script en niri/scripts/launch-mindwtr.sh que detecta AppImage dinámico o Flatpak)
spawn-sh-at-startup "[ \"$HOSTNAME\" = abdel-lite ] || exec ~/.config/niri/scripts/launch-mindwtr.sh"



// ── Ajustes de escritorio (gsettings / xdg) ──
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface gtk-enable-primary-paste true"
// dms-open.desktop enruta los enlaces al navegador que gestiona DMS
spawn-sh-at-startup "xdg-settings set default-web-browser dms-open.desktop"
spawn-sh-at-startup "xdg-mime default dms-open.desktop x-scheme-handler/http"
spawn-sh-at-startup "xdg-mime default dms-open.desktop x-scheme-handler/https"
// SmallDocs como visor/editor predeterminado de Markdown (.md)
spawn-sh-at-startup "xdg-mime default sdoc.desktop text/markdown text/x-markdown"
