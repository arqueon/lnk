#!/bin/bash

WP=${1:?Wallpaper path required}

# =============================================================================
# BLOQUE ESPECÍFICO POR ENTORNO
# =============================================================================
if [[ "${XDG_CURRENT_DESKTOP,,}" == *niri* ]]; then
    # Dux 2.0 owns both steps: `wallpaper set` stores the path for every present
    # and future output and regenerates the palette with the user's spec,
    # scheme, contrast and smart mode. Pre-generating here ran matugen twice and
    # could contradict smart mode, so the script no longer does it.
    dms ipc call wallpaper set "$WP"

    # Dux can replace settings.json atomically. Keeping the greeter group on it
    # means the next logout still finds a readable config. The greeter takes the
    # wallpaper from session.json (updated by `wallpaper set`) and grants itself
    # access with ACLs; Dux 2.0 removed the old `greeterWallpaperPath` setting.
    DUX_SETTINGS="$HOME/.config/dms/settings.json"
    case " $(id -nG) " in
        *" greeter "*)
            chgrp greeter "$DUX_SETTINGS" 2>/dev/null || true
            chmod g+r "$DUX_SETTINGS" 2>/dev/null || true
            ;;
    esac
elif [ "$XDG_CURRENT_DESKTOP" == "qtile" ] || [ "$DESKTOP_SESSION" == "qtile" ]; then
    matugen image "$WP" -t scheme-kde > ~/.local/share/color-schemes/DankMatugen.colors
    qtile cmd-obj -o cmd -f reload_config
fi

# Dux Theme Sync ya observa la firma de colores/ajustes de Dux con autoSync y
# agrupa los cambios antes de aplicar. No forzar aquí una segunda pasada: con
# varias ventanas de Chrome abiertas, dos recargas GTK consecutivas podían dejar
# el indicador de pestaña activa desactualizado en unas ventanas y no en otras.

# =============================================================================
# BLOQUE DE TEMA DESACTIVADO — ahora lo gestiona el plugin dmsThemeSync.
# Se conserva comentado como referencia; NO borrar. Reactivar quitando los '#'.
# =============================================================================
# # Obtener fuentes, iconos y cursor desde los ajustes de Dux de forma dinámica
# DUX_SETTINGS="$HOME/.config/dms/settings.json"
