// ═══ user.kdl (POR-HOST: ofi) ═══
// Solo lo específico de ofi; lo compartido vive en user-common.kdl.


window-rule {
    match app-id="google-chrome"
    default-column-width { proportion 0.9; }
    open-focused true
}

window-rule {
    match app-id="firefox"
    default-column-width { proportion 0.7; }
    open-focused true
}

/- window-rule {
    match app-id=r#"^(firefox|org\.mozilla\.firefox)(-.*)?$"#
    match app-id=r#"^google-chrome(-.*)?$"#
    match app-id=r#"^com\.google\.Chrome(-.*)?$"#
    open-on-workspace "web"
}


// ── Arranque de triple instancia de Logseq (casa, ofi, laptop) ──
spawn-at-startup "logseq-multi-launch"

// ── Binds propios ──
binds {
    Mod+F4 { spawn "logseq-multi-launch"; }
}
