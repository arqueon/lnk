// ═══ user.kdl (POR-HOST: ofi) ═══
// Solo lo específico de ofi; lo compartido vive en user-common.kdl.


window-rule {
    match app-id="google-chrome"
    default-column-width { proportion 0.6; }
    open-focused true
}

window-rule {
    match app-id="firefox"
    default-column-width { proportion 0.6; }
    open-focused true
}

/- window-rule {
    match app-id=r#"^(firefox|org\.mozilla\.firefox)(-.*)?$"#
    match app-id=r#"^google-chrome(-.*)?$"#
    match app-id=r#"^com\.google\.Chrome(-.*)?$"#
    open-on-workspace "web"
}


window-rule {
    match app-id="hermes-broker-unlock"
    open-floating true
    default-column-width { fixed 680; }
    default-window-height { fixed 260; }
    open-focused true
}

// ── Arranque de Logseq DB canónico (arq-unificado); los OG quedan como archivo ──
spawn-sh-at-startup "exec ~/.local/bin/logseqdb"

// ── Binds propios ──
binds {
    Mod+F1 { spawn "firefox"; }
    Mod+Alt+F1 { spawn-sh "~/.config/niri/scripts/run_chrome.sh"; }
    Mod+Shift+F2 repeat=false hotkey-overlay-title="Apps de Google por cuenta" { spawn "~/.config/niri/scripts/launch-google-apps-menu.sh"; }
    Mod+F4 { spawn-sh "exec ~/.local/bin/logseqdb"; }
    Mod+Ctrl+Shift+F10 hotkey-overlay-title="Desbloquear Broker Moodle de Hermes" { spawn "~/.config/niri/scripts/hermes-bw-moodle-unlock.sh"; }
}

